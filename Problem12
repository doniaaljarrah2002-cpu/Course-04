
#include <iostream>
#include <string>
using namespace std;

//Write a Program To Ask The User To Enter : Number1 , Number2
//Then Print The MAX Number.

void ReadNumbers(int& Number1, int& Number2)
{
	cout << "Plz Enter Number1 : ";
	cin >> Number1;

	cout << "Plz Enter Number2 : ";
	cin >> Number2;
}

int MaxOf2Numbers(int Number1, int Number2)
{
	if (Number1 > Number2)
		return Number1;
	else
		return Number2;
}

void PrintResult(int Max)
{
	cout << "\nThe Maximum Number Is : " << Max << endl;
}

int main()
{
	int Number1, Number2;
	ReadNumbers(Number1, Number2);
	PrintResult(MaxOf2Numbers(Number1, Number2));
}
