
#include <iostream>
using namespace std;

// Write a program to calculate triangle area 
// and print it on the screen.
// Area = 0.5* a * h

void ReadNumbers(float& A, float& H)
{
	cout << "Plz Enter Triangle Base A : ";
	cin >> A;

	cout << "plz Enter Triangle Height H : ";
	cin >> H;
}

float TriangleArea(float A, float H)
{
	float Area = 0.5 * A * H;
	return Area;
}

void PrintResult(float Area)
{
	cout << "\nTriangle Area = " << Area << endl;
}

int main()
{
	float A, H;
	ReadNumbers(A, H);
	PrintResult(TriangleArea(A, H));
}
