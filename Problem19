
#include <iostream>
#include <cmath>
using namespace std;

//Write a Program To Calculate Circle Area Through Diameter,
// Then Print It On The Screen 
//Area = (PI * pow(D, 2)) / 4

float ReadDiameter()
{
	float D;
	cout << "Plz Enter Diameter(D) : ";
	cin >> D;
	return D;
}

float CircleAreaThroughDiameter(float D)
{
	const float PI = 3.14;
	float Area = (PI * pow(D, 2)) / 4;
	return Area;
}

void PrintResult(float Area)
{
	cout << "\nCircleAreaThroughDiameter = " << Area << endl;
}

int main()
{
	PrintResult(CircleAreaThroughDiameter(ReadDiameter()));
}












