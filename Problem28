
#include <iostream>
using namespace std;

//Write a Program To Sum Odd Numbers From 1 To Num

enum enOddEven { Odd = 1, Even = 2 };

int ReadNumber()
{
	int Number;
	cout << "Plz Enter Number : ";
	cin >> Number;
	return Number;
}

enOddEven CheckOddOrEven(int Number)
{
	if (Number % 2 == 0)
		return enOddEven::Even;
	else
		return enOddEven::Odd;
}

int SumOddNumbersFrom1toN(int Number)
{
	cout << "\nSum Odd Numbers : ";

	int Counter = 0;
	int Sum = 0;

	while (Counter < Number)
	{
		Counter++;
		if (CheckOddOrEven(Counter) == enOddEven::Odd)
		{
			Sum += Counter;
		}
	}
	return Sum;
}

int main()
{
	cout << SumOddNumbersFrom1toN(ReadNumber()) << endl;
}



















