
#include <iostream>
#include <cmath>
using namespace std;

//Write a Program To Calculate Circle Area Then Print
// It On The Screen
//Area = PI * pow(R, 2)

float ReadRadius()
{
	float R;
	cout << "Plz Enter Radius(R) : ";
	cin >> R;
	return R;
}

float CircleArea(float R)
{
	const float PI = 3.14;
	float Area = PI * pow(R, 2);
	return Area;
}

void PrintResult(float Area)
{
	cout << "\nCircle Area = " << Area << endl;
}

int main()
{
	PrintResult(CircleArea(ReadRadius()));
}














